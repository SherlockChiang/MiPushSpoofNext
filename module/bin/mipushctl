#!/system/bin/sh

# Re-enter through the root manager's BusyBox so Android 8 devices have the
# same awk/grep/sed/unzip implementation as modern devices.
if [ "${MPSN_ASH_STANDALONE:-0}" != "1" ]; then
  BUSYBOX_PATH=
  for candidate in "${MPSN_BUSYBOX:-}" \
    /data/adb/magisk/busybox /data/adb/ksu/bin/busybox /data/adb/ap/bin/busybox; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
      BUSYBOX_PATH=$candidate
      break
    fi
  done
  if [ -z "$BUSYBOX_PATH" ] && command -v busybox >/dev/null 2>&1; then
    BUSYBOX_PATH=$(command -v busybox)
  fi
  if [ -z "$BUSYBOX_PATH" ]; then
    echo "A Magisk/KernelSU/APatch BusyBox executable is required." >&2
    exit 1
  fi
  export ASH_STANDALONE=1 MPSN_ASH_STANDALONE=1 MPSN_BUSYBOX="$BUSYBOX_PATH"
  exec "$BUSYBOX_PATH" sh "$0" "$@"
fi

MODDIR=${0%/*}
MODDIR=${MODDIR%/bin}
STATE=/data/adb/mipush-spoof-next
MANUAL="$STATE/packages.txt"
AUTO="$STATE/packages.auto.txt"
MODES="$STATE/package_modes.conf"
OPTIONS="$STATE/options.conf"
TEMP=
umask 077

cleanup() {
  [ -z "$TEMP" ] || rm -f "$TEMP"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

die() {
  echo "$*" >&2
  exit 1
}

new_temp() {
  TEMP="$1.tmp.$$"
  rm -f "$TEMP" || return 1
}

commit_temp() {
  target=$1
  chmod 0600 "$TEMP" && mv -f "$TEMP" "$target" || return 1
  TEMP=
}

atomic_copy() {
  source_file=$1
  target_file=$2
  new_temp "$target_file" && cp -f "$source_file" "$TEMP" && commit_temp "$target_file"
}

ensure_state() {
  mkdir -p "$STATE/profiles" "$STATE/logs" || return 1
  chmod 0700 "$STATE" "$STATE/profiles" "$STATE/logs" || return 1
  for profile in "$MODDIR"/defaults/profiles/*.properties; do
    [ -f "$profile" ] || continue
    target="$STATE/profiles/${profile##*/}"
    [ -f "$target" ] || atomic_copy "$profile" "$target" || return 1
  done
  [ -f "$OPTIONS" ] || atomic_copy "$MODDIR/defaults/options.conf" "$OPTIONS" || return 1
  [ -f "$MANUAL" ] || atomic_copy "$MODDIR/defaults/packages.txt" "$MANUAL" || return 1
  [ -f "$MODES" ] || atomic_copy "$MODDIR/defaults/package_modes.conf" "$MODES" || return 1
  if [ ! -f "$AUTO" ]; then
    new_temp "$AUTO" && : > "$TEMP" && commit_temp "$AUTO" || return 1
  fi
  [ -f "$STATE/profile.properties" ] || \
    atomic_copy "$MODDIR/defaults/profiles/miui14.properties" "$STATE/profile.properties" || return 1
  chmod 0600 "$OPTIONS" "$MANUAL" "$AUTO" "$MODES" "$STATE/profile.properties" \
    "$STATE/profiles"/*.properties || return 1
}

usage() {
  echo "Usage: mipushctl <scan|manage|list|apps|app|app-status|mode|enable|disable|auto|state|profile|observe|status> [value]"
  echo "  scan                  Detect installed APKs containing MiPush SDK markers"
  echo "  manage                Scan and manage apps with the volume keys"
  echo "  list                  Show friendly manual and automatic app states"
  echo "  apps                  Print tab-separated app states and modes for WebUI clients"
  echo "  app <pkg> <state>     Set an app to auto, enable, or disable"
  echo "  app-status <pkg>      Show an app's effective selection state"
  echo "  mode <rule> [mode]    Show or set what a selected app receives:"
  echo "                        inherit, full, properties, build, observe, excluded"
  echo "  inherit-mode          Show what inherit resolves to from options.conf"
  echo "  enable <rule>         Set one exact manual allow rule"
  echo "  disable <rule>        Set one exact manual deny rule"
  echo "  auto <rule>           Clear that exact manual rule"
  echo "  state <rule>          Print enabled, disabled, auto, or inactive"
  echo "  add|deny|remove       Legacy aliases for enable|disable|auto"
  echo "  profile [name]        List profiles or activate one"
  echo "  observe <on|off>      Toggle property-key observation"
  echo "  status                Show active settings"
}

valid_rule() {
  value=$1
  case "$value" in
    ''|-*|.*|*.|*..*|*[!A-Za-z0-9._:-]*) return 1 ;;
  esac
  base=${value%%:*}
  case "$base" in
    ''|*[!A-Za-z0-9._]*|*..*|.*|*.) return 1 ;;
    *.*) ;;
    *) return 1 ;;
  esac
  case "$value" in
    *:*)
      suffix=${value#*:}
      case "$suffix" in ''|*:*) return 1 ;; esac
      ;;
  esac
  return 0
}

valid_package() {
  valid_rule "$1" || return 1
  case "$1" in *:*) return 1 ;; esac
  return 0
}

protected_package() {
  case "$1" in
    android|system_server|com.android.*|com.google.android.gms|\
    com.xiaomi.xmsf|com.topjohnwu.magisk|me.weishu.kernelsu|com.rifsxd.ksunext|\
    me.bmax.apatch|org.lsposed.manager|com.tencent.mm|top.trumeet.mipush) return 0 ;;
    *) return 1 ;;
  esac
}

valid_mode() {
  case "$1" in
    inherit|full|properties|build|observe|excluded) return 0 ;;
    *) return 1 ;;
  esac
}

# Print "rule<TAB>mode" for each package_modes.conf entry, trimmed and lowercased
# the way the native parser reads them. An empty value is reported as invalid.
mode_entries() {
  awk '
    {
      line=$0
      sub(/#.*/, "", line)
      separator=index(line, "=")
      if (separator == 0) next
      key=substr(line, 1, separator - 1)
      value=substr(line, separator + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (key != "") print key "\t" (value == "" ? "invalid" : tolower(value))
    }
  ' "$MODES" 2>/dev/null
}

# Print the mode configured for exactly this rule (the last matching line wins,
# as in the native parser), or inherit when there is none.
mode_of() {
  mode_entries | awk -F '\t' -v rule="$1" '
    $1 == rule { mode=$2 }
    END { print (mode == "" ? "inherit" : mode) }
  '
}

# Print what inherit currently resolves to from options.conf, parsed like the
# native companion: full, properties, build, observe or none, plus "+observe"
# when observation is added to a spoofing mode.
inherit_mode() {
  awk '
    function flag(value, fallback) {
      value = tolower(value)
      if (value == "1" || value == "true" || value == "yes" || value == "on") return 1
      if (value == "0" || value == "false" || value == "no" || value == "off") return 0
      return fallback
    }
    BEGIN { props = 1; build = 1; observe = 0 }
    {
      line = $0
      sub(/#.*/, "", line)
      separator = index(line, "=")
      if (separator == 0) next
      key = substr(line, 1, separator - 1)
      value = substr(line, separator + 1)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (key == "spoof_properties") props = flag(value, props)
      else if (key == "spoof_build_fields") build = flag(value, build)
      else if (key == "observe_properties") observe = flag(value, observe)
    }
    END {
      if (props && build) mode = "full"
      else if (props) mode = "properties"
      else if (build) mode = "build"
      else if (observe) mode = "observe"
      else mode = "none"
      if (observe && mode != "observe" && mode != "none") mode = mode "+observe"
      print mode
    }
  ' "$OPTIONS"
}

# Count the package:process entries that override this package's own mode.
process_mode_count() {
  mode_entries | awk -F '\t' -v prefix="$1:" '
    index($1, prefix) == 1 { count++ }
    END { print count + 0 }
  '
}

# Print the packer the last scan detected for this package, or none.
scan_hardening() {
  hardening=$(awk -v candidate="candidate=$1" '
    $1 == candidate {
      for (i = 2; i <= NF; i++) if ($i ~ /^hardening=/) { sub(/^hardening=/, "", $i); print $i }
      exit
    }
  ' "$STATE/logs/scan.log" 2>/dev/null)
  echo "${hardening:-none}"
}

set_mode() {
  rule=$1
  mode=$2
  replacement=
  [ "$mode" = inherit ] || replacement="$rule=$mode"
  new_temp "$MODES" || return 1
  awk -v rule="$rule" -v replacement="$replacement" '
    {
      line=$0
      sub(/#.*/, "", line)
      separator=index(line, "=")
      if (separator > 0) {
        key=substr(line, 1, separator - 1)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        if (key == rule) next
      }
      print
    }
    END { if (replacement != "") print replacement }
  ' "$MODES" > "$TEMP" && commit_temp "$MODES"
}

valid_profile() {
  case "$1" in
    ''|-*|.*|*.|*..*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}

set_rule_state() {
  rule=$1
  state=$2
  replacement=
  case "$state" in
    enabled) replacement=$rule ;;
    disabled) replacement="!$rule" ;;
    auto) ;;
    *) return 1 ;;
  esac
  new_temp "$MANUAL" || return 1
  awk -v allow="$rule" -v deny="!$rule" -v replacement="$replacement" '
    $0 == allow || $0 == deny { next }
    { print }
    END { if (replacement != "") print replacement }
  ' "$MANUAL" > "$TEMP" && commit_temp "$MANUAL"
}

set_app_state() {
  package=$1
  state=$2
  replacement=
  case "$state" in
    enabled) replacement=$package ;;
    disabled) replacement="!$package" ;;
    auto) ;;
    *) return 1 ;;
  esac
  new_temp "$MANUAL" || return 1
  awk -v package="$package" -v replacement="$replacement" '
    {
      candidate=$0
      sub(/^!/, "", candidate)
      if (candidate == package || index(candidate, package ":") == 1) next
      print
    }
    END { if (replacement != "") print replacement }
  ' "$MANUAL" > "$TEMP" && commit_temp "$MANUAL"
}

rule_state() {
  rule=$1
  base=${rule%%:*}
  if grep -Fqx -e "!$rule" "$MANUAL" 2>/dev/null || \
    { [ "$base" != "$rule" ] && grep -Fqx -e "!$base" "$MANUAL" 2>/dev/null; }; then
    echo disabled
  elif grep -Fqx -e "$rule" "$MANUAL" 2>/dev/null || \
    { [ "$base" != "$rule" ] && grep -Fqx -e "$base" "$MANUAL" 2>/dev/null; }; then
    echo enabled
  elif grep -Fqx -e "$rule" "$AUTO" 2>/dev/null || \
    { [ "$base" != "$rule" ] && grep -Fqx -e "$base" "$AUTO" 2>/dev/null; }; then
    echo auto
  else
    echo inactive
  fi
}

app_state() {
  package=$1
  if protected_package "$package"; then
    echo protected
  elif grep -Fqx -e "!$package" "$MANUAL" 2>/dev/null; then
    echo disabled
  elif grep -Fqx -e "$package" "$MANUAL" 2>/dev/null; then
    echo enabled
  elif awk -v prefix="$package:" '
    { candidate=$0; sub(/^!/, "", candidate); if (index(candidate, prefix) == 1) found=1 }
    END { exit(found ? 0 : 1) }
  ' "$MANUAL" 2>/dev/null; then
    echo custom
  elif grep -Fqx -e "$package" "$AUTO" 2>/dev/null; then
    echo auto-enabled
  else
    echo auto-inactive
  fi
}

apply_app_state() {
  package=$1
  if /system/bin/am force-stop "$package"; then
    echo "Force-stopped $package; reopen it to apply the new state."
  else
    echo "Rule saved, but force-stop failed for $package." >&2
    return 1
  fi
}

read_volume_key() {
  seconds=${1:-30}
  [ -x /system/bin/getevent ] || return 3
  while :; do
    event=$("$MPSN_BUSYBOX" timeout "$seconds" /system/bin/getevent -qlc 1 2>/dev/null)
    event_status=$?
    [ "$event_status" -eq 124 ] && return 2
    [ "$event_status" -eq 0 ] || return 3
    case "$event" in
      *KEY_VOLUMEUP*DOWN*) echo up; return 0 ;;
      *KEY_VOLUMEDOWN*DOWN*) echo down; return 0 ;;
    esac
  done
}

print_rules() {
  echo "Manual overrides:"
  manual_count=0
  while IFS= read -r rule; do
    case "$rule" in
      ''|\#*) continue ;;
      !*) echo "  DISABLED  ${rule#!}" ;;
      *) echo "  ENABLED   $rule" ;;
    esac
    manual_count=$((manual_count + 1))
  done < "$MANUAL"
  [ "$manual_count" -ne 0 ] || echo "  (none)"
  echo "Automatic scan candidates (manual DISABLED rules win):"
  auto_count=0
  while IFS= read -r rule; do
    case "$rule" in ''|\#*) continue ;; esac
    packer=$(scan_hardening "$rule")
    case "$packer" in
      none) echo "  AUTO      $rule" ;;
      *) echo "  AUTO      $rule [hardening: $packer]" ;;
    esac
    auto_count=$((auto_count + 1))
  done < "$AUTO"
  [ "$auto_count" -ne 0 ] || echo "  (none; run mipushctl scan)"
  echo "Capability modes (package_modes.conf; unlisted apps inherit options.conf):"
  mode_count=0
  tab=$(printf '\t')
  entries=$(mode_entries)
  while IFS=$tab read -r rule mode; do
    [ -n "$rule" ] || continue
    if valid_mode "$mode"; then
      label=$(echo "$mode" | tr '[:lower:]' '[:upper:]')
      note=
    elif [ "$mode" = invalid ]; then
      label=INVALID
      note=" (empty or unknown value, so the process is excluded)"
    else
      label=INVALID
      note=" ('$mode' is unknown, so the process is excluded)"
    fi
    printf '  %-9s %s%s\n' "$label" "$rule" "$note"
    mode_count=$((mode_count + 1))
  done <<EOF
$entries
EOF
  [ "$mode_count" -ne 0 ] || echo "  (none)"
}

# One row per package for the WebUI:
# state<TAB>package<TAB>package mode<TAB>hardening<TAB>package:process mode count
print_app_rows() {
  packages=$(
    {
      grep -v -E '^[[:space:]]*(#|$)' "$MANUAL" 2>/dev/null
      grep -v -E '^[[:space:]]*(#|$)' "$AUTO" 2>/dev/null
      mode_entries | cut -f1
    } | sed -e 's/^!//' -e 's/:.*//' | awk '!seen[$0]++'
  )
  for package in $packages; do
    printf '%s\t%s\t%s\t%s\t%s\n' "$(app_state "$package")" "$package" "$(mode_of "$package")" \
      "$(scan_hardening "$package")" "$(process_mode_count "$package")"
  done
}

set_option() {
  key=$1
  value=$2
  new_temp "$OPTIONS" || return 1
  awk -F= -v key="$key" -v value="$value" '
    BEGIN { found=0 }
    $1 == key { print key "=" value; found=1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$OPTIONS" > "$TEMP" && commit_temp "$OPTIONS"
}

ensure_option_defaults() {
  for pair in \
    'scan_system_apps=false' \
    'scan_deep=false' \
    'scan_max_apk_bytes=157286400'; do
    key=${pair%%=*}
    value=${pair#*=}
    if ! grep -q "^$key=" "$OPTIONS" 2>/dev/null; then
      set_option "$key" "$value" || return 1
    fi
  done
}

ensure_state || die "Unable to initialize secure state at $STATE."
ensure_option_defaults || die "Unable to migrate configuration defaults."

case "${1:-}" in
  scan)
    exec "$MPSN_BUSYBOX" sh "$MODDIR/bin/scan_packages.sh"
    ;;
  list)
    print_rules
    ;;
  apps)
    print_app_rows
    ;;
  inherit-mode)
    inherit_mode
    ;;
  enable|add|disable|deny|auto|remove)
    rule=${2:-}
    valid_rule "$rule" || { echo "Invalid package/process rule: $rule" >&2; exit 2; }
    case "$1" in
      enable|add) state=enabled ;;
      disable|deny) state=disabled ;;
      auto|remove) state=auto ;;
    esac
    set_rule_state "$rule" "$state" || die "Failed to update $MANUAL."
    echo "$rule: $(rule_state "$rule")"
    echo "Restart ${rule%%:*} to apply the change."
    ;;
  state)
    rule=${2:-}
    valid_rule "$rule" || { echo "Invalid package/process rule: $rule" >&2; exit 2; }
    rule_state "$rule"
    ;;
  app-status)
    package=${2:-}
    valid_package "$package" || { echo "Invalid package name: $package" >&2; exit 2; }
    app_state "$package"
    ;;
  app)
    package=${2:-}
    requested=${3:-}
    valid_package "$package" || { echo "Invalid package name: $package" >&2; exit 2; }
    protected_package "$package" && {
      echo "$package is protected and cannot be enabled or managed." >&2
      exit 2
    }
    case "$requested" in
      auto) new_state=auto ;;
      enable|enabled) new_state=enabled ;;
      disable|disabled) new_state=disabled ;;
      *) echo "app expects: <package> <auto|enable|disable> [--apply]" >&2; exit 2 ;;
    esac
    case "${4:-}" in ''|--apply) ;; *) echo "Unknown app option: $4" >&2; exit 2 ;; esac
    set_app_state "$package" "$new_state" || die "Failed to update $MANUAL."
    echo "$package: $(app_state "$package")"
    if [ "${4:-}" = --apply ]; then
      apply_app_state "$package" || exit 1
    else
      echo "Restart $package to apply the change (or add --apply next time)."
    fi
    ;;
  mode)
    rule=${2:-}
    valid_rule "$rule" || { echo "Invalid package/process rule: $rule" >&2; exit 2; }
    protected_package "${rule%%:*}" && {
      echo "${rule%%:*} is protected and is never injected." >&2
      exit 2
    }
    if [ -z "${3:-}" ]; then
      echo "$rule: $(mode_of "$rule")"
      exit 0
    fi
    requested=$3
    valid_mode "$requested" || {
      echo "mode expects: <rule> <inherit|full|properties|build|observe|excluded> [--apply]" >&2
      exit 2
    }
    case "${4:-}" in ''|--apply) ;; *) echo "Unknown mode option: $4" >&2; exit 2 ;; esac
    set_mode "$rule" "$requested" || die "Failed to update $MODES."
    echo "$rule: $(mode_of "$rule")"
    if [ "${4:-}" = --apply ]; then
      apply_app_state "${rule%%:*}" || exit 1
    else
      echo "Restart ${rule%%:*} to apply the change (or add --apply next time)."
    fi
    ;;
  manage)
    echo "Scanning installed apps for MiPush support..."
    "$MPSN_BUSYBOX" sh "$MODDIR/bin/scan_packages.sh" || exit $?
    echo
    print_rules
    echo
    echo "Press VOLUME UP within 15 seconds to open app controls."
    echo "Press VOLUME DOWN (or wait) to finish after scanning."
    key=$(read_volume_key 15)
    key_status=$?
    [ "$key_status" -eq 0 ] || {
      echo "Interactive keys unavailable or timed out; scan results were saved."
      exit 0
    }
    [ "$key" = up ] || exit 0
    packages=$(
      {
        grep -v -E '^[[:space:]]*(#|$)' "$MANUAL" 2>/dev/null
        grep -v -E '^[[:space:]]*(#|$)' "$AUTO" 2>/dev/null
      } | sed -e 's/^!//' -e 's/:.*//' | awk '!seen[$0]++'
    )
    [ -n "$packages" ] || {
      echo "No candidate apps found. Add one with: mipushctl enable <package>"
      exit 0
    }
    echo
    echo "For each app: VOLUME DOWN changes the state; VOLUME UP confirms it."
    echo "States cycle: AUTO -> DISABLED -> ENABLED -> AUTO."
    for package in $packages; do
      if protected_package "$package"; then
        echo
        echo "$package [protected; skipped]"
        continue
      fi
      changed=0
      while :; do
        state=$(app_state "$package")
        echo
        echo "$package [$state]"
        key=$(read_volume_key 30)
        key_status=$?
        [ "$key_status" -eq 0 ] || {
          echo "Timed out; saved all changes made so far."
          exit 0
        }
        [ "$key" = up ] && break
        case "$state" in
          auto-enabled|auto-inactive) next_state=disabled ;;
          disabled) next_state=enabled ;;
          enabled|custom) next_state=auto ;;
          *) next_state=auto ;;
        esac
        set_app_state "$package" "$next_state" || die "Failed to update $MANUAL."
        changed=1
        echo "Changed to: $next_state"
      done
      if [ "$changed" -eq 1 ]; then
        echo "Press VOLUME UP to apply now by force-stopping $package."
        echo "Press VOLUME DOWN to restart it yourself later."
        key=$(read_volume_key 30)
        key_status=$?
        [ "$key_status" -eq 0 ] || {
          echo "Timed out; rule saved without force-stopping the app."
          continue
        }
        [ "$key" = up ] && apply_app_state "$package"
      fi
    done
    echo
    echo "Done. Force-stop and reopen changed apps to apply their new state."
    ;;
  profile)
    if [ -z "${2:-}" ]; then
      echo "Available profiles:"
      for file in "$STATE"/profiles/*.properties; do
        [ -f "$file" ] || continue
        name=${file##*/}
        echo "  ${name%.properties}"
      done
    else
      name=$2
      valid_profile "$name" || { echo "Invalid profile name: $name" >&2; exit 2; }
      source_file="$STATE/profiles/$name.properties"
      [ -f "$source_file" ] || { echo "Unknown profile: $name" >&2; exit 2; }
      atomic_copy "$source_file" "$STATE/profile.properties" || die "Failed to activate profile."
      echo "Activated profile: $name"
    fi
    ;;
  observe)
    case "${2:-}" in
      on) set_option observe_properties true || die "Failed to update observation setting." ;;
      off) set_option observe_properties false || die "Failed to update observation setting." ;;
      *) echo "observe expects on or off" >&2; exit 2 ;;
    esac
    echo "Property observation: $2 (restart target apps)"
    ;;
  status)
    echo "State directory: $STATE"
    echo "Options:"
    sed 's/^/  /' "$OPTIONS"
    echo "Active profile identity:"
    grep -E '^(prop\.ro\.(miui\.ui|mi\.os)\.version|build\.(BRAND|MANUFACTURER))' \
      "$STATE/profile.properties" 2>/dev/null | sed 's/^/  /'
    "$MPSN_BUSYBOX" sh "$0" list
    ;;
  *)
    usage
    exit 2
    ;;
esac
